# Copy to .env.local and fill in. Validated in src/env.ts.

# Public base URL, used for absolute metadata/OG URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pto

# Auth. Generate the secret with: npx @better-auth/cli secret
# (or any random string of 32+ characters).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
